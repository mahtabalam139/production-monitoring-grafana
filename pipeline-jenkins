pipeline {
    agent { label "slave" }

    stages {

        stage("Clone") {
            steps {
                git branch: 'main',
                    url: 'https://github.com/mahtabalam139/production-monitoring-dashboard.git'
            }
        }

        stage("Build") {
            steps {
                sh 'docker build -t monitoring-dashboard:1.0 .'
            }
        }

        stage("Deploy") {
            steps {
                sh '''
                    docker stop monitoring-dashboard || true
                    docker rm monitoring-dashboard || true

                    docker run -d \
                      --name monitoring-dashboard \
                      -p 8000:8000 \
                      -v //var/run/docker.sock:/var/run/docker.sock \
                      monitoring-dashboard:1.0
                '''
            }
        }

        stage("Verify") {
            steps {
                sleep 15
                sh 'curl -f http://localhost:8000'
            }
        }

        stage("Veryfying the images an health check "){
            steps{
                echo "verifying the images "
                sleep time: 15, unit: 'SECONDS'
                sh 'curl http://localhost:8000'
                echo "Finnalllyyy Done updated hhhurayyyyy"
            }
        }
        stage("push to docker hub"){
            steps{
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS')]){
                            sh '''
                            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                            docker tag monitoring-dashboard:latest \
                            $DOCKER_USER/monitoring-dashboard:latest
                            docker push 
                            $DOCKER_USER/monitoring-dashboard:latest
                            '''
                        }
            }
        }  
    }
}
